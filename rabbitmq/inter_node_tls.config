%% inter_node_tls.config — Erlang distribution TLS settings
%% Used by both rabbitmq (primary) and rabbitmq-spare nodes.
%%
%% Each container mounts its own cert at /etc/rabbitmq/certs/node.crt
%% and /etc/rabbitmq/certs/node.key via Docker volume aliases, so this
%% single shared file works for both nodes without modification.
%%
%% Referenced from rabbitmq.conf via:
%%   ssl_dist_optfile = /etc/rabbitmq/inter_node_tls.config

[{server, [
    {cacertfile, "/etc/rabbitmq/certs/ca.crt"},
    {certfile,   "/etc/rabbitmq/certs/node.crt"},
    {keyfile,    "/etc/rabbitmq/certs/node.key"},
    {verify,     verify_peer},
    {fail_if_no_peer_cert, false},
    {versions,   ['tlsv1.3', 'tlsv1.2']}
]},
{client, [
    {cacertfile, "/etc/rabbitmq/certs/ca.crt"},
    {certfile,   "/etc/rabbitmq/certs/node.crt"},
    {keyfile,    "/etc/rabbitmq/certs/node.key"},
    {verify,     verify_none},
    {fail_if_no_peer_cert, false},
    {versions,   ['tlsv1.3', 'tlsv1.2']}
]}].
